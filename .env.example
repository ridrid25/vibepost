# Скопируй этот файл в .env и заполни. Файл .env НЕ коммитить и никому не отправлять.

# Supabase (Settings → API)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_PROJECT_REF=XXXX
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Telegram — тестовые данные
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=-100XXXXXXXXXX
ERROR_NOTIFY_TG_ID=

# Секрет для защиты telegram-webhook (придумай длинную случайную строку)
TELEGRAM_WEBHOOK_SECRET=

# TikTok Login Kit / Display API. Store production values as Supabase Edge
# Function secrets; these placeholders are only for local function serving.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://XXXX.supabase.co/functions/v1/tiktok-oauth-callback
VIBEPOST_APP_ORIGIN=https://chrono-vibepost.lovable.app
